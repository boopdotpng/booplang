; int (int32), float (float32), half (float16), bool (comparisons only).
; every value has one concrete type. literals adapt to the other operand; anything else needs a cast.

fn main()
  a = 7
  b = 2
  print(a / b, a % b)   ; int / is integer division, % is int only
  x = 7.0
  print(x / 2)   ; 2 becomes 2.0
  h = 1.5h
  print(h * 2)   ; 2 becomes 2.0h
  print(float(a) / 2.0)   ; explicit cast
  print(a * a + b * -3)
  print(a < b, a == 7, not (a < b) and b != 0)
  a = float(a) * 0.5     ; outside a block, rebinding is just a new SSA value, type can change
  print(a)

; out:
; 3 1
; 3.5
; 3
; 3.5
; 43
; false true true
; 3.5
