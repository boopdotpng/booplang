; arrays: fixed size known at compile time, live on the stack.
; [..] literal, or T[n] for a zeroed array.

fn main()
  a = [3.0, 1.0, 4.0, 1.0, 5.0]
  total = 0.0
  for i in 5
    total = total + a[i]
  print(total)
  sq = int[8]
  for i in 8
    sq[i] = i * i
  print(sq[0], sq[7])

; out:
; 14
; 0 49
